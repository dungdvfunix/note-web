{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notes-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "API", "service": "notes-api" }]
}
